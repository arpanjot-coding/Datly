# ==============================================================================
# Datly Environment Configuration Template
# Copy this file to .env:  cp .env.template .env
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=5567
DEV_MODE=false

# Session Security (Auto-generated if left blank)
# FLASK_SECRET_KEY=

# Workspace Storage Directory (Default: ~/.data_formulator)
# DATA_FORMULATOR_HOME=

# Code Execution Sandbox ('local' for process isolation, 'docker' for container sandbox)
SANDBOX=local

# Display Controls
MAX_DISPLAY_ROWS=10000
DISABLE_DISPLAY_KEYS=false
DISABLE_DATA_CONNECTORS=false
DISABLE_CUSTOM_MODELS=false

# LLM Provider API Keys (Or configure BYOK interactively via the in-app settings dialog)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local / Offline Model Endpoint (e.g., Ollama, vLLM, LocalAI)
OLLAMA_API_BASE=http://localhost:11434

# Enterprise Cloud Connectors (Optional - or configure interactively in the Datly UI)
# Databricks
# DATABRICKS_SERVER_HOSTNAME=
# DATABRICKS_HTTP_PATH=
# DATABRICKS_ACCESS_TOKEN=

# Google Cloud BigQuery
# GOOGLE_APPLICATION_CREDENTIALS=

# PostgreSQL
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=datly
# PGUSER=postgres
# PGPASSWORD=

# MySQL
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=datly
# MYSQL_USER=root
# MYSQL_PASSWORD=
